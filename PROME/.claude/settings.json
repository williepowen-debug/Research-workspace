{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/session_banner.sh\"",
            "timeout": 30,
            "statusMessage": "Boot banner: repo sync + env flags (flag-not-force)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/PROME/tools/hooks/prompt_clock.sh\"",
            "timeout": 5,
            "statusMessage": "Clock stamp"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/PROME/tools/hooks/git_guard.py\"",
            "timeout": 5,
            "statusMessage": "git guard (root canon prohibitions)"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/PROME/tools/hooks/commit_subject_guard.py\"",
            "timeout": 5,
            "statusMessage": "commit-subject guard (root 4d, \u2264100 chars \u2014 BLOCKING, WQ-244)"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/PROME/tools/hooks/pipeline_rc_block.py\"",
            "timeout": 5,
            "statusMessage": "pipeline-rc guard (BLOCKING, WQ-244)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/PROME/tools/hooks/forge_validate.py\"",
            "timeout": 90,
            "statusMessage": "post-save validator (FORGE/STATUS \u00b7 GATES \u00b7 DOCKET)"
          }
        ]
      }
    ]
  }
}
