+def _ignore_witness(sc, pattern, parent, salt='x'):
+    """A path below parent that matches pattern, or None when none exists."""
+    parts = tuple(pattern.split('/'))
+    base = tuple(parent.split('/'))
+
+    def walk(i, j, extra):
+        if len(extra) > len(parts):
+            return None
+        if i == len(parts):
+            candidate = '/'.join(base + extra)
+            return candidate if extra and sc._match(pattern, candidate) else None
+        segment = parts[i]
+        if segment == '**':
+            found = walk(i + 1, j, extra)
+            if found is not None:
+                return found
+            if j < len(base):
+                return walk(i, j + 1, extra)
+            return walk(i, j, extra + (salt,))
+        if j < len(base):
+            if sc._match(segment, base[j]):
+                return walk(i + 1, j + 1, extra)
+            return None
+        candidate = re.sub(r'[*?]', salt, segment) or salt
+        return walk(i + 1, j, extra + (candidate,))
+
+    return walk(0, 0, ())
+
+
+def _wholly_excluded(sc, parent, rules):
+    """An EXCLUDED terminal /** covers the subtree only absent an earlier non-EXCLUDED match."""
+    ancestors = [str(parent)] + [str(p) for p in PurePosixPath(parent).parents if str(p) != '.']
+    for i, (pattern, cls, _) in enumerate(rules):
+        if cls != 'EXCLUDED':
+            continue
+        covers = pattern == '**' or (
+            pattern.endswith('/**') and any(sc._match(pattern[:-3], p) for p in ancestors))
+        if covers and not any(
+                earlier_cls != 'EXCLUDED' and _ignore_witness(sc, earlier, parent) is not None
+                for earlier, earlier_cls, _ in rules[:i]):
+            return True
+    return False
+
