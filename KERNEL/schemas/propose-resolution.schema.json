{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel/propose-resolution/1",
  "title": "Kernel v1 ProposeResolution payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolution_id", "question_id", "outcome_value", "proposed_by",
    "resolution_evidence_refs", "negative_search_attempt", "annulment_reason"
  ],
  "properties": {
    "resolution_id": {"type": "string", "pattern": "^R-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "question_id": {"type": "string", "pattern": "^Q-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "outcome_value": {"enum": ["YES", "NO", "AMBIGUOUS", "ANNULLED"]},
    "proposed_by": {"type": "string", "minLength": 1},
    "resolution_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "negative_search_attempt": {"type": ["string", "null"]},
    "annulment_reason": {"type": ["string", "null"]}
  }
}
