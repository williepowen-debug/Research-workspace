{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel/verify-resolution/1",
  "title": "Kernel v1 VerifyResolution payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolution_id", "question_id", "verified_outcome_value", "verified_by",
    "verification_evidence_refs", "disposition"
  ],
  "properties": {
    "resolution_id": {"type": "string", "pattern": "^R-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "question_id": {"type": "string", "pattern": "^Q-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "verified_outcome_value": {"enum": ["YES", "NO", "AMBIGUOUS", "ANNULLED"]},
    "verified_by": {"type": "string", "minLength": 1},
    "verification_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "disposition": {"const": "VERIFY"}
  }
}
