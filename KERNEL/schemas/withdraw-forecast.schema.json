{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel/withdraw-forecast/1",
  "title": "Kernel v1 WithdrawForecast payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["forecast_id", "question_id", "forecaster_actor_id"],
  "properties": {
    "forecast_id": {"type": "string", "pattern": "^F-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "question_id": {"type": "string", "pattern": "^Q-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "forecaster_actor_id": {"type": "string", "minLength": 1}
  }
}
