{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel/close-question/1",
  "title": "Kernel v1 CloseQuestion payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "closed_by", "closed_at"],
  "properties": {
    "question_id": {"type": "string", "pattern": "^Q-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "closed_by": {"type": "string", "minLength": 1},
    "closed_at": {"type": "string", "format": "date-time"}
  }
}
