{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel/command/1",
  "title": "Kernel v1 fixture command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_version", "command_id", "command_type", "actor_id", "submitted_at",
    "expected_version", "target_stream_id", "correlation_id", "caused_by", "depends_on", "payload", "native_refs"
  ],
  "properties": {
    "schema_version": {"const": "kernel.schema.1"},
    "policy_version": {"const": "kernel.policy.1"},
    "command_id": {"type": "string", "pattern": "^CMD-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "command_type": {"enum": ["RegisterQuestion", "SubmitForecast"]},
    "actor_id": {"type": "string", "minLength": 1},
    "submitted_at": {"type": "string", "format": "date-time"},
    "expected_version": {"type": "integer", "minimum": 0},
    "target_stream_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": ["string", "null"]},
    "caused_by": {"type": ["string", "null"]},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CMD-"}},
    "payload": {"type": "object"},
    "native_refs": {"type": "array", "minItems": 1, "items": {"$ref": "native-ref.schema.json"}}
  }
}
