    "impacts": [
      {
        "stage": 13,
        "statement": "Water level rises in parking lots at Lake Monroe Hospital and approaches New Tribes Mission in Sanford."
      },
      {
        "stage": 11,
        "statement": "Water enters the Sailpoint Apartments, Lake Monroe Inn, City Hall and approaches the Courthouse in Sanford."
      },
      {
        "stage": 10.5,
        "statement": "Water enters the Regatta Shores Apartments and Towne Center Apartments in Sanford."
      },
      {
        "stage": 10,
        "statement": "Water enters the old Post Office and Sanford Landing Apartments in Sanford."
      },
      {
        "stage": 9.5,
        "statement": "Water encroaches on Sanford Landing Apartments and other low lying structures along the waterfront."
      },
      {
        "stage": 9,
        "statement": "Flooding becomes more significant to the Sanford waterfront area. Water approaches low lying areas on the waterfront."
      },
      {
        "stage": 8,
        "statement": "Flooding becomes more significant to low lying structures and marinas along the river in Volusia and Seminole counties, including Sanford, Enterprise and Lake Monroe."
      },
      {
        "stage": 7.4,
        "statement": "Many secondary roads are flooded and may become impassable around Lake Monroe and in Enterprise. Rising water begins to impact more areas of Stone Island and water approaches homes in River Oaks Estates."
      },
      {
        "stage": 7,
        "statement": "Water begins to move over sea wall around Lake Monroe and rises into grassy areas around the sea wall. Water begins to encroach on Seminole Boulevard."
      },
      {
        "stage": 6.5,
        "statement": "Water enters a few lower lying homes in the Stone Island and Stillbrook subdivisions. The road into Stone Island becomes impassable. Water rises onto low lying property near Sanford. Parks and docks are flooded near Lake Monroe."
      },
      {
        "stage": 6.2,
        "statement": "Water completely surrounds many homes in the Stone Island and Still Brook subdivisions. Pool enclosures and patios become flooded. Water covers many of the roads. Flooding occurs on Enterprise Road and in the Bethel Loop subdivision."
      },
      {
        "stage": 6,
        "statement": "Water encroaches on low lying roads, also pool enclosures and patios in the Stone Island area."
      },
      {
        "stage": 5.5,
        "statement": "Water surrounds homes and covers some driveways in the Stone Island area near Enterprise in Volusia County. Water enters yards and floods docks in the River Oaks Estates subdivision."
      },
      {
        "stage": 4.2,
        "statement": "No wake zone and parks closed along the river, also some boat ramps closed."
      }
    ]
  },
