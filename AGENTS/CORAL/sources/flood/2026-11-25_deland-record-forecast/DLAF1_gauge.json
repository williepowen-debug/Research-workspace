    "impacts": [
      {
        "stage": 5.3,
        "statement": "Major flooding occurs to many structures and marinas along the river and in the Hontoon Island area."
      },
      {
        "stage": 4.8,
        "statement": "Water starts to enter low lying buildings around Hontoon Island. Many secondary roads and homes in low lying areas are flooded."
      },
      {
        "stage": 4.5,
        "statement": "Water moves into yards and approaches buildings around Hontoon Island."
      },
      {
        "stage": 4,
        "statement": "Docks and piers are completely submerged at Pier 44 Marina. Many docks are partially submerged at Hontoon Landing Marina."
      },
      {
        "stage": 3.5,
        "statement": "Flooding of campsites and trails occurs at Hontoon Island State Park."
      }
    ]
