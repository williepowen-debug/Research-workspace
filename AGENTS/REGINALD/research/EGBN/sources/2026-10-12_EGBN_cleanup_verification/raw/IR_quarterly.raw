            </div>
            <div class="evergreen-accordion-content">
                <div class="evergreen-financial-accordion-links-container evergreen-financial-accordion-list-container">
                    {{#docs.length}}
                        <ul class="evergreen-styleless-list evergreen-accordion-content-text evergreen-financial-accordion-links-container-inner evergreen-financial-accordion-links-container--vertical">
                            {{#docs}}
                                <li class="evergreen-financial-accordion-link evergreen-financial-accordion-attachment{{#docType}} {{docType}}{{/docType}}">
                                    <a href="{{docUrl}}" target="_blank" class="evergreen-financial-accordion-link{{#docType}} evergreen-financial-accordion-attachment-{{docType}}{{/docType}} evergreen-link--text-with-icon evergreen-link " aria-label="{{docTitle}} of {{shortType}} {{year}}, {{urlFileType}}, opens in new window">
                                        <span class="{{docIcon}}" aria-hidden="true"></span>
                                        <span class="evergreen-link-text evergreen-financial-accordion-link-text">{{{docTitle}}}</span>
                                        <span class="sr-only" aria-hidden="true"> of {{shortType}} {{year}}, {{urlFileType}}, (opens in new window)</span>
                                    </a>
                                </li>
                            {{/docs}}
                        </ul>
                    {{/docs.length}}
                    {{^docs.length}}
                        <div class="evergreen-accordion-content-text evergreen-financial-accordion-links-container-inner evergreen-financial-accordion-links-container--empty">
                            <div class="evergreen-financial-accordion-empty-warning">
                                <span class="evergreen-icon-warning-line"></span>
                                <span class="evergreen-financial-accordion-link-text">There is no financial data to display</span>
                            </div>
                        </div>
                    {{/docs.length}}
                </div>
            </div>
        </div>
    </script>

    <script id="_ctrl0_ctl26_divModuleContainertplEvergreenFinancialAccordionCard" type="text/template">
        <div class="evergreen-accordion evergreen-financial-accordion-item">
            <div class="evergreen-accordion-header evergreen-financial-accordion-accordion-header evergreen-accordion-header--padding ">
                <button class="evergreen-financial-accordion-toggle">
                    <div class="evergreen-accordion-header-text">
                        <div class="evergreen-accordion-title">{{year}}</div>
                    </div>
                </button>
            </div>
            <div class="evergreen-accordion-content">
                <div class="evergreen-financial-accordion-card-container">
                    {{#content}}
                        {{#docs.length}}
                        <div class="evergreen-financial-accordion-card evergreen-financial-accordion-card--border">
                            <div class="evergreen-financial-accordion-card-header">
                                <h4 class="evergreen-financial-accordion-card-title">{{shortType}}</h4>
                            </div>
                            <div class="evergreen-financial-accordion-card-links-container">
                                <ul class="evergreen-styleless-list evergreen-accordion-content-text evergreen-financial-accordion-links-container-inner evergreen-financial-accordion-links-container--vertical">
                                    {{#docs}}
                                        <li class="evergreen-financial-accordion-link evergreen-financial-accordion-attachment{{#docType}} {{docType}}{{/docType}}">
                                            <a href="{{docUrl}}" target="_blank" class="evergreen-financial-accordion-link{{#docType}} evergreen-financial-accordion-attachment-{{docType}}{{/docType}} evergreen-link--text-with-icon evergreen-link " aria-label="{{docTitle}} of {{shortType}} {{year}}, {{urlFileType}}, opens in new window">
                                                <span class="{{docIcon}}" aria-hidden="true"></span>
                                                <span class="evergreen-link-text evergreen-financial-accordion-link-text">{{{docTitle}}}</span>
                                                <span class="sr-only" aria-hidden="true"> of {{shortType}} {{year}}, {{urlFileType}}, (opens in new window)</span>
                                            </a>
                                        </li>
                                    {{/docs}}
                                </ul>
                            </div>
                        </div>
                    {{/docs.length}}
                    {{/content}}
                </div>
            </div>
        </div>
    </script>

    <script>
        (function ($tudio) {

            const _groupBy = (array, key) => {
                const groupedObj = array.reduce(function (map, x) {
                    const keyVal = x[key];
                    if (!map.has(keyVal)) {
                        map.set(keyVal, []);
                    }
                    map.get(keyVal).push(x);
                    return map;
                }, new Map());
                return Array.from(groupedObj, ([groupedKey, groupedValue]) => ({ year: groupedKey, content: groupedValue }));
            };

            const _sortReportTypes = (reports) => {
                const order = ["First Quarter", "Second Quarter", "Third Quarter", "Fourth Quarter", "Annual Report", "Supplemental Report", "ESG Report"];
                return [...reports].sort((a, b) => order.indexOf(a.shortType) - order.indexOf(b.shortType));
            };

            const _flattenReportsByType = (reports) => {
                return reports.reduce((acc, report) => {
                    const found = acc.find(r => r.shortType === report.shortType);
                    if (!found) {
                        return acc.concat(report);
                    }
                    found.docs = found.docs.concat(report.docs);
                    return acc;
                }, []);
            };

            $tudio('#_ctrl0_ctl26_divModuleContainer').q4Financials({
                fetchAllYears: false,
                showAllYears: true,
                yearContainer: '#_ctrl0_ctl26_selectEvergreenFinancialAccordionYear',
                yearTemplate: '<option value="{{value}}">{{ year }}</option>',
                yearSelect: '#_ctrl0_ctl26_selectEvergreenFinancialAccordionYear',
                allYearsText: 'All',
                itemNotFoundMessage: $tudio('#_ctrl0_ctl26_divModuleContainertplEvergreenFinancialAccordionNoItems').html(),
                loadingMessage: $tudio("#_ctrl0_ctl26_divModuleContainertplEvergreenFinancialAccordionLoading").html(),
                itemContainer: '#_ctrl0_ctl26_divFinancialAccordionItemsContainer',
                itemTemplate: $tudio('#_ctrl0_ctl26_divModuleContainertplEvergreenFinancialAccordionCard').html(),
                reportTypes: ["First Quarter","Second Quarter","Third Quarter","Fourth Quarter",""],
                docCategories: ["news","webcast","presentation","transcript","other",""],
                shortTypes: {"Annual Report":"Annual Report","First Quarter":"First Quarter","Second Quarter":"Second Quarter","Third Quarter":"Third Quarter","Fourth Quarter":"Fourth Quarter","Supplemental Report":"Supplemental Report","ESG Report":"ESG Report"},
                categoryIcons: {"file":"evergreen-module-icon","online":"evergreen-module-icon-link","placeholder":"evergreen-module-icon"},
                itemsComplete: function (e) {
                    q4EvergreenHelpers.toggle({
                        $container: $tudio('#_ctrl0_ctl26_divFinancialAccordionItemsContainer'),
                        item: '.evergreen-financial-accordion-item',
                        toggle: '.evergreen-financial-accordion-accordion-header button',
                        panel: '.evergreen-accordion-content',
                        accordion: false,
                        openBehavior: 1,
                        includeClasses: true,
                        toggleIcon: {
                            collapsed: "evergreen-icon-chevron-down",
                            expanded: "evergreen-icon-chevron-up",
                        },
                        appendToggleIcon: true,
                    });
                    announceSrOnlyFinancialCount(e);
                },
                beforeRenderItems: function (e, tplData) {
                    if (true) {
                        // will group the data by year, e.g. { year: '2020', content: [ { ... }, { ... } ] }
                        const grouped = _groupBy(tplData.items, 'year')

                        // sort and flatten the content by report type
                        grouped.forEach((group) => {
                            group.content = _sortReportTypes(_flattenReportsByType(group.content));
                        });
                        tplData.items = grouped;
                    }
                },
                complete: function (e) {
                    if (false) {
                        $tudio(".evergreen-financial-accordion-item").on("expand-panel", (e) => {
                            const $item = $tudio(e.currentTarget);
                            const $items = $tudio(".evergreen-financial-accordion-item", $item.parent());
                            const noBorderClass = "evergreen-financial-accordion-no-border-bottom";
                            $items.removeClass(noBorderClass);
                            $item.prev().addClass(noBorderClass);
                        });
                    }
                    announceSrOnlyFinancialCount(e);
                },
            });
            announceSrOnlyFinancialCount = function (e) {
                $tudio("#_ctrl0_ctl26_divModuleContainerdivEvergreenFinancialAccordionStatusAnnouncement").remove();
                q4EvergreenHelpers.a11yAnnouncement('polite', '_ctrl0_ctl26_divModuleContainerdivEvergreenFinancialAccordionStatusAnnouncement', $tudio(e.target).find('#_ctrl0_ctl26_divEvergreenFinancialAccordionYearOptionContainer'), function (el) {
                    var year = document.getElementById('_ctrl0_ctl26_selectEvergreenFinancialAccordionYear');
                    var container = document.getElementById('_ctrl0_ctl26_divFinancialAccordionItemsContainer');

                    var itemCount = 0;
                    if (container) {
                        itemCount = container.querySelectorAll('.evergreen-financial-accordion-item').length;
                    }
                    $tudio(el).text('Showing ' + itemCount + ' financial item(s) from year ' + ((year === null || year.value === '-1') ? 'All' : year.value));
                });
            }
        })($tudio);
    </script>
</div>
</div>
        </div>
    </main>
