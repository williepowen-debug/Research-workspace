            quicklinkMenuTarget: '#_ctrl0_ctl01_navCorporateNavigationDesktopContainer',
            quicklinkMenuData: [{"Title":"Our Story","Url":"https://www.eaglebankcorp.com/our-story/","Target":"_blank"},{"Title":"Community","Url":"https://www.eaglebankcorp.com/community/","Target":"_blank"},{"Title":"News","Url":"https://www.eaglebankcorp.com/news/","Target":"_blank"},{"Title":"Investor Relations","Url":"https://ir.eaglebankcorp.com/overview/default.aspx","Target":"_self"},{"Title":"Careers","Url":"https://careers.eaglebankcorp.com/","Target":"_blank"},{"Title":"Security","Url":"https://www.eaglebankcorp.com/security/","Target":"_blank"},{"Title":"Locations","Url":"https://www.eaglebankcorp.com/locations/","Target":"_blank"},{"Title":"Contact Us","Url":"https://www.eaglebankcorp.com/contact/","Target":"_blank"}],
            onComplete: function () {
                adjustBannerPadding();
                addFieldsetToSearch();
            }
        });
    </script>
