+# ── OWNER-DIRECTED NOTICE (DOCKET L530 open leg, DAEDALUS 2026-10-08 — READ_CAP rule 15) ──────────
+# Rule 15 counts a cross-agent whole read in the READER's perimeter and promises the OWNER a notice.
+# Until this, the notice existed only in prose: the breach printed in the READER's run (and turned
+# the READER red), while the owner — the only desk that can rotate the bytes (rule 4) — ran its own
+# check and never saw the file. Measured 2026-10-08: `--agent WALTER` showed AGENTS/HANS/registry/
+# THRESHOLDS.tsv at 103% of budget (WALTER:6b); `--agent HANS` never named it.
+# ⛔ NOT CAP-BEARING HERE: the notice never enters the owner's totals and never moves its rc by
+# default — moving the verdict onto the owner is a CANON question (`--owner-notice-blocking`, opt-in,
+# unadopted). Owner = the desk whose home contains the path; READS.tsv has no `owner` column today,
+# and if one is ever populated a disagreement with the path is REPORTED, never silently resolved.
+def foreign_reads(name, path=None, root=None):
+    """(entries, findings) or (UNAVAILABLE, err).
+    entries:  {abs_path: {"readers": [reader:step (mode), ...], "missing": bool}} — every file under
+              `name`'s home that ANOTHER reader's cap-bearing READ row loads (CLASS rows expanded per
+              member with the SAME helper as declared_reads).
+    findings: [str] — OWNER/PATH disagreements (A5); never attributed either way."""
+    rows, err = load_reads(path)
+    if rows is None:
+        return UNAVAILABLE, err
+    base_root = root or ROOT
+    home = os.path.normpath(desk_home(name))
+    home_rel = os.path.relpath(home, ROOT).replace(os.sep, "/").rstrip("/") + "/"
+    sub_rel = home_rel + "sub_agents/"          # sub-agent desks own their own subtree (A5)
+
+    def under_home(rel):
+        rel = rel.replace(os.sep, "/")
+        return rel.startswith(home_rel) and not rel.startswith(sub_rel)
+
+    entries, findings = {}, []
+    for r in rows:
+        if r.get("row_kind") != "READ" or (r.get("reader") or "").strip() == name:
+            continue
+        mode = (r.get("mode") or "").strip()
+        pth = (r.get("path") or "").strip()
+        if not pth or mode not in CAP_BEARING_MODES or pth.startswith(EXTERNAL_ROOTS):
+            continue                                # RETIRED / visible / bad-mode rows: the reader's run owns them
+        rdr, step = (r.get("reader") or "?").strip(), (r.get("source_boot_step") or "?").strip()
+        who = (step if step.startswith(rdr + ":") else f"{rdr}:{step}") \
+              + ("" if mode == "whole" else f" ({mode})")
+        if "*" in pth or "?" in pth:
+            targets = [(m, False) for m in _class_members(pth, base_root)]
+        else:
+            full = os.path.normpath(os.path.join(base_root, pth))
+            targets = [(full, not os.path.isfile(full))]
+        oc = (r.get("owner") or "").strip()
+        for full, missing in targets:
+            rel = os.path.relpath(full, base_root)
+            mine = under_home(rel)
+            if oc and (oc == name) != mine:
+                findings.append(f"OWNER/PATH DISAGREE: `{rel}` ({who}) — owner column `{oc}`, path "
+                                f"{'IS' if mine else 'is NOT'} under {home_rel} — not attributed; the "
+                                f"reader fixes the row")
+                continue
+            if not mine:
+                continue
+            e = entries.setdefault(full, {"readers": [], "missing": missing})
+            if who not in e["readers"]:
+                e["readers"].append(who)
+    return entries, findings
+
