    },
    "impacts": [
      {
        "stage": 10.8,
        "statement": "Water covers State Road 46 and it may become impassable near Jungle Road and Prevatt Road. Standing water on secondary roads near the river deepens to more than three feet in some areas. Flooding becomes more significant to structures and marinas from above Lake Harney to the Lake Jesup area."
      },
      {
        "stage": 10.5,
        "statement": "Water covers many secondary roads near the river, limiting access to homes to boats or high terrain vehicles. Flooding of homes along secondary roads near the river becomes more significant. Water begins to encroach on State Road 46 near Jungle Road and Prevatt Road."
      },
      {
        "stage": 10,
        "statement": "Flooding of homes in low lying areas becomes more significant. Many secondary roads are impassable, limiting access to homes."
      },
      {
        "stage": 9.5,
        "statement": "Water begins to move into homes in low lying areas along the river. Flooding around the Black Hammock area near Lake Jesup."
      },
      {
        "stage": 9.3,
        "statement": "Many secondary roads are flooded near Lake Harney. Flooding in the Hatbill Road area near Loughman Lake."
      },
      {
        "stage": 9,
        "statement": "Water enters the first story of homes on Whitcomb Drive between Crossover Lane and Lake Harney Road. Water covers Mullet Lake Park."
      },
      {
        "stage": 8.8,
        "statement": "Water covers Whitcomb Road."
      },
      {
        "stage": 8.5,
        "statement": "Water surrounds homes on stilts on Prevatt road, entering garages on the first story. Water fills yards and ditches along Whitcomb Drive and Lake Harney Road. Roads flood in the Palm Shores and Mullet Lake areas."
      },
      {
        "stage": 8.3,
        "statement": "Docks are partially submerged along the river between Lake Harney and Lemon Bluff."
      },
      {
        "stage": 8,
        "statement": "Water moves into yards on Prevatt Road off State Road 46 near Lake Harney. Flooding of boat ramps and roads occurs in Mullet Lake Park."
      },
      {
        "stage": 7.5,
        "statement": "Some docks, islands and small trees along the river north of Lake Harney will be covered with water, making boating hazardous."
      },
      {
        "stage": 7,
        "statement": "Water approaches boat ramps, docks in Lake Jesup Park and Mullet Lake Park."
      },
      {
        "stage": 6.5,
        "statement": "Minor flooding to a few low lying areas along the river."
      },
      {
        "stage": 6,
        "statement": "No Wake Zones in effect and county parks closed for areas east of Lake Monroe to Lake Harney."
      }
    ]
  },
