+def news_batches(saved, last_marked):
+    """Batches to scan, oldest first: every data/<day>/news.json with day after the marked
+    batch's day and up to the newest (`saved`), always including `saved`. No pointer, an
+    unparseable pointer, or no `saved` = [saved] only (install behaviour, nothing replayed)."""
+    if not saved:
+        return []
+    m_new = _BATCH_RE.match(saved)
+    m_old = _BATCH_RE.match(last_marked or "")
+    if not m_new or not m_old:
+        return [saved]
+    lo, hi = m_old.group(1), m_new.group(1)
+    out = []
+    try:
+        for d in sorted(p.name for p in (LANE / "data").iterdir() if p.is_dir()):
+            rel = f"data/{d}/news.json"
+            if lo < d < hi and (LANE / rel).exists():
+                out.append(rel)
+    except OSError:
+        pass
+    return out + [saved]
+
+
+def pointer_health(last_marked):
+    """MED when a stored pointer cannot drive catch-up; silent when absent (install) or valid."""
+    if last_marked is None:
+        return []
+    if not _BATCH_RE.match(last_marked) or not (LANE / last_marked).exists():
+        return [("MED", f"last_marked_batch {last_marked!r} unparseable or missing in the lane — "
+                        "news catch-up OFF, newest batch only; the next --mark resets it")]
+    return []
+
