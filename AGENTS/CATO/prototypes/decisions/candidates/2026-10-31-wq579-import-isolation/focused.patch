-# Runs only when the docket is part of the commit; reads the index (GIT_INDEX_FILE-aware,
-# so `git commit <path>` sees the temporary index git builds for that commit). Fails closed.
+# Local safeguard, bypassable with --no-verify. Account-number guard on every commit;
+# PROME/DOCKET.tsv line stability when staged. Python helpers use isolated imports.
+# Dormant changed-row byte cap retired under WQ-578; this hook ships with WQ-579 acceptance.
 set -u
 root=$(git rev-parse --show-toplevel) || exit 1
