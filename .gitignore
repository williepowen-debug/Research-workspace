# Sensitive files
*.key
*.pem
*secret*
*token*
.env

# OS files
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.swp
*~

# Python
__pycache__/
*.pyc

# Node
node_modules/

# Logs that shouldn't be versioned
*.log
.venv/

# Windows download metadata
*:Zone.Identifier

# Bank primary source materials — local only (PDFs, 10-K HTML dumps, quarterly supplements)
# In quarter dirs: exclude every file by default, then allow .md text (synthesis + transcripts).
# Note: cannot exclude the dir itself — git won't traverse into ignored dirs, breaking the negation.
AGENTS/REGINALD/*/sources/*.pdf
AGENTS/REGINALD/*/sources/10k_*/
AGENTS/REGINALD/*/sources/q[1-4]_*/*
!AGENTS/REGINALD/*/sources/q[1-4]_*/*.md

# Local large/source artifacts — keep raw statutory PDFs out of Git
AGENTS/SHADE/sources/athene_statutory_2026-06-15/*.pdf
AGENTS/SHADE/research/tmp_aaia_extract/venv/

# Sensitive material removed in the 2026-06 public-prep scrub — keep it out for good
WILL/trading-journal/
*.pkl
